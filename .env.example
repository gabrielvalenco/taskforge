# Copie para .env e ajuste. Todas as chaves usam o prefixo TASKFORGE_.

# --- Fila: memory | redis | sqs | servicebus -------------------------------------------------
TASKFORGE_QUEUE_BACKEND=redis
TASKFORGE_REDIS_URL=redis://localhost:6379/0

# SQS (valores vêm dos outputs do Terraform em infra/terraform/envs/aws)
# TASKFORGE_QUEUE_BACKEND=sqs
# TASKFORGE_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/taskforge-dev-jobs
# TASKFORGE_SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/taskforge-dev-jobs-dlq
# TASKFORGE_AWS_REGION=us-east-1
# TASKFORGE_AWS_ENDPOINT_URL=http://localhost:4566   # só para LocalStack

# Azure Service Bus (valores vêm dos outputs do Terraform em infra/terraform/envs/azure)
# TASKFORGE_QUEUE_BACKEND=servicebus
# TASKFORGE_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://...
# TASKFORGE_SERVICEBUS_QUEUE_NAME=taskforge-jobs

# --- Execução ----------------------------------------------------------------------------------
TASKFORGE_EXECUTION_BACKEND=local     # local | celery
TASKFORGE_IO_THREADS=16
TASKFORGE_CPU_PROCESSES=2
TASKFORGE_BATCH_SIZE=8
TASKFORGE_JOB_TIMEOUT_SECONDS=300     # o visibility timeout da fila precisa ser MAIOR que isto
TASKFORGE_VISIBILITY_TIMEOUT_SECONDS=360

# --- Persistência e operação -------------------------------------------------------------------
TASKFORGE_DATABASE_PATH=taskforge.db
TASKFORGE_LOG_LEVEL=INFO
TASKFORGE_LOG_JSON=true

# Módulos extras com handlers próprios (separados por vírgula). Obrigatório para handlers PROCESS.
# TASKFORGE_PLUGINS=meu_pacote.handlers
